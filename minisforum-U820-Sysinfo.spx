						<key>unique</key>
						<string>Microsoft Trebuchet</string>
						<key>valid</key>
						<string>yes</string>
						<key>vendor</key>
						<string>Microsoft Corporation</string>
						<key>version</key>
						<string>Version 5.00x</string>
					</dict>
